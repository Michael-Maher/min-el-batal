rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Players collection - allow read/write for game data
    match /players/{playerId} {
      allow read, write: if true;
    }
    // Leaderboard collection - allow read/write for rankings
    match /leaderboard/{playerId} {
      allow read, write: if true;
    }
    // Blitz leaderboard
    match /blitzLeaderboard/{playerId} {
      allow read, write: if true;
    }
    // Competition rooms - allow read/write for multiplayer
    match /compete_rooms/{roomId} {
      allow read, write: if true;
    }
    // Weekly competition rankings
    match /compete_rankings/{rankId} {
      allow read, write: if true;
    }
    // Duels (1v1)
    match /duels/{duelId} {
      allow read, write: if true;
    }
    // Boss battle (shared world state)
    match /bossBattle/{docId} {
      allow read, write: if true;
    }
    // Lessons collection - for new lesson notifications
    match /lessons/{lessonId} {
      allow read, write: if true;
    }
    // Teams collection - for team management
    match /teams/{teamId} {
      allow read, write: if true;
    }
    // Reward requests - for gift redemptions
    match /reward_requests/{requestId} {
      allow read, write: if true;
    }
    // In-app announcements (admin-authored, shown in-app and optionally pushed)
    match /announcements/{announcementId} {
      allow read, write: if true;
    }
    // Admin accounts and access requests
    match /admins/{adminId} {
      allow read, write: if true;
    }
    match /admin_requests/{requestId} {
      allow read, write: if true;
    }
    // Q&A — player asks questions, admins answer
    match /questions/{questionId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    // Admin-managed content locks (cards / levels / subjects / lessons)
    match /gameContent/{docId} {
      allow read, write: if true;
    }
    // Per-lesson learn-tab videos/content edited in admin, read by the game
    match /learnTabConfig/{docId} {
      allow read, write: if true;
    }
    // Score-season backups written by the admin «بدء موسم جديد» (players/ and blitz/ subcollections)
    match /seasonArchives/{archiveId}/{document=**} {
      allow read, write: if true;
    }
    match /seasonArchives/{archiveId} {
      allow read, write: if true;
    }
    // Player audit/event log (writes from game, reads from admin)
    match /playerEvents/{eventId} {
      allow read, write: if true;
    }
    // Player-on-player reports (writes from game, reads/updates from admin)
    match /playerReports/{reportId} {
      allow read, write: if true;
    }
    // Tournaments — admin-created competitions ("كاس مين البطل")
    match /tournaments/{tournamentId} {
      allow read, write: if true;
    }
    // Tournament question bank — themed pool used by tournaments
    match /tournament_questions/{questionId} {
      allow read, write: if true;
    }
    // Social feed — admin/system posts + player reactions/comments
    match /posts/{postId} {
      allow read, write: if true;
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }
    // Live presence — heartbeat per active player
    match /presence/{playerId} {
      allow read, write: if true;
    }
    // Selfie challenge — admin-managed weekly team photo challenges
    match /selfieChallenges/{challengeId} {
      allow read, write: if true;
    }
    // Selfie challenge submissions — one per team per challenge
    // Attendance: admin-printed meeting QR sessions + one record per player per meeting.
    // Records are create-only (no update), so a player can't be recorded (or rewarded) twice
    // for the same meeting; admins may delete a wrong record.
    match /attendanceSessions/{sessionId} {
      allow read, write: if true;
    }
    match /attendance/{recordId} {
      allow read, create, delete: if true;
      allow update: if false;
    }
    match /selfieSubmissions/{submissionId} {
      allow read, write: if true;
    }

    // ── Notifications ── no Firebase Auth: rules only bound the shape of what clients may write.
    // Written by Cloud Functions only (Admin SDK bypasses rules).
    match /notifications/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /notifySent/{id} {
      allow read, write: if false;
    }
    match /inviteGuard/{id} {
      allow read, write: if false;
    }
    match /pushTokens/{token} {
      allow read: if false;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['owner', 'role', 'updatedAt'])
        && request.resource.data.keys().hasAll(['owner', 'role', 'updatedAt'])
        && request.resource.data.owner is string && request.resource.data.owner.size() <= 64
        && request.resource.data.role in ['player', 'admin']
        && request.resource.data.updatedAt is int;
    }
    match /notifyQueue/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['type', 'key', 'title', 'level', 'createdAt'])
        && request.resource.data.keys().hasAll(['type', 'key', 'title', 'level', 'createdAt'])
        && request.resource.data.type == 'lesson_unlock'
        && request.resource.data.key is string
        && request.resource.data.key.matches('^(lesson|subject|level)_[a-z0-9_]+$')
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.level in [0, 1, 2]
        && get(/databases/$(database)/documents/gameContent/locks).data[request.resource.data.key].locked == false;
    }
    match /invites/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['kind', 'from', 'fromName', 'to', 'code', 'createdAt'])
        && request.resource.data.keys().hasAll(['kind', 'from', 'fromName', 'to', 'code', 'createdAt'])
        && request.resource.data.kind in ['duel', 'room']
        && request.resource.data.from is string && request.resource.data.to is string
        && request.resource.data.from != request.resource.data.to
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60
        && request.resource.data.code is string && request.resource.data.code.size() <= 12;
    }
  }
}
